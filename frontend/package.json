{
  "name": "probe-frontend",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "bundle:data": "npm run bundle:data:synthetic && npm run bundle:data:real",
    "bundle:data:synthetic": "node scripts/bundle-data.mjs",
    "bundle:data:real": "DATA_SOURCE=real node scripts/bundle-data.mjs",
    "dev": "npm run bundle:data && next dev",
    "build": "npm run bundle:data && next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
